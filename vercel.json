{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "admin.html", "use": "@vercel/static" },
    { "src": "aviso-legal.html", "use": "@vercel/static" },
    { "src": "privacidad.html", "use": "@vercel/static" },
    { "src": "terminos.html", "use": "@vercel/static" },
    { "src": "manifest.json", "use": "@vercel/static" },
    { "src": "sw.js", "use": "@vercel/static" },
    { "src": "icons/**", "use": "@vercel/static" },
    { "src": "manuales/**", "use": "@vercel/static" },
    { "src": "api/chat.js", "use": "@vercel/node" },
    { "src": "api/admin.js", "use": "@vercel/node" },
    { "src": "api/history.js", "use": "@vercel/node" },
    { "src": "api/garage.js", "use": "@vercel/node" },
    { "src": "api/stripe-checkout.js", "use": "@vercel/node" },
    { "src": "api/stripe-webhook.js", "use": "@vercel/node" },
    { "src": "api/stripe-portal.js", "use": "@vercel/node" },
    { "src": "api/subscription.js", "use": "@vercel/node" },
    { "src": "api/feedback.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/chat", "dest": "/api/chat.js" },
    { "src": "/api/admin", "dest": "/api/admin.js" },
    { "src": "/api/history", "dest": "/api/history.js" },
    { "src": "/api/garage", "dest": "/api/garage.js" },
    { "src": "/api/stripe-checkout", "dest": "/api/stripe-checkout.js" },
    { "src": "/api/stripe-webhook", "dest": "/api/stripe-webhook.js" },
    { "src": "/api/stripe-portal", "dest": "/api/stripe-portal.js" },
    { "src": "/api/subscription", "dest": "/api/subscription.js" },
    { "src": "/api/feedback", "dest": "/api/feedback.js" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/aviso-legal", "dest": "/aviso-legal.html" },
    { "src": "/privacidad", "dest": "/privacidad.html" },
    { "src": "/terminos", "dest": "/terminos.html" },
    { "src": "/manifest.json", "dest": "/manifest.json" },
    { "src": "/sw.js", "dest": "/sw.js" },
    { "src": "/icons/(.*)", "dest": "/icons/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
